<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback Configuration
    Controls how log messages are formatted and where they are written.
    In production, you would add a RollingFileAppender here.
-->
<configuration>

    <!-- Console Appender: Writes logs to standard output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File Appender: Writes logs to a rolling file -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/banking-app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Roll over daily -->
            <fileNamePattern>logs/banking-app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Keep 30 days of history -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress HikariCP verbose startup logs (set to WARN in dev) -->
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <!-- Root logger: INFO level for application code -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
